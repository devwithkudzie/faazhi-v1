      "id": "logic-practice-1",
      "type": "practice",
      "title": "Even or Odd",
      "task": "Write pseudocode to input a number and output Even if it is divisible by 2, otherwise output Odd.",
      "difficulty": "easy",
      "expectedThinking": [
        "INPUT: one number",
        "PROCESS: check whether num MOD 2 = 0",
        "OUTPUT: Even or Odd"
      ],
      "assessment": {
        "totalMarks": 5,
        "markScheme": [
          {
            "criterion": "DECLARE variable",
            "marks": 1
          },
          {
            "criterion": "INPUT number",
            "marks": 1
          },
          {
            "criterion": "Correct IF condition using MOD",
            "marks": 1
          },
          {
            "criterion": "Correct ELSE branch",
            "marks": 1
          },
          {
            "criterion": "Correct OUTPUT statements",
            "marks": 1
          }
        ],
        "expectedAnswer": "DECLARE num : INTEGER\n\nINPUT num\n\nIF num MOD 2 = 0 THEN\n    OUTPUT \"Even\"\nELSE\n    OUTPUT \"Odd\"\nENDIF",
        "unlock": {
          "markScheme": "after_submit",
          "expectedAnswer": "after_submit"
        }
      }
    },
    {
      "id": "logic-practice-2",
      "type": "practice",
      "title": "Display Values Greater Than 10",
      "task": "Write pseudocode to output numbers from 1 to 20, but only display numbers greater than 10.",
      "difficulty": "medium",
      "expectedThinking": [
        "Use a loop to generate numbers from 1 to 20",
        "Use IF to check if the number is greater than 10",
        "Only output values that pass the condition"
      ],
      "assessment": {
        "totalMarks": 6,
        "markScheme": [
          {
            "criterion": "DECLARE loop variable",
            "marks": 1
          },
          {
            "criterion": "Correct loop from 1 to 20",
            "marks": 2
          },
          {
            "criterion": "Correct IF condition",
            "marks": 1
          },
          {
            "criterion": "OUTPUT only inside IF",
            "marks": 1
          },
          {
            "criterion": "Correct loop ending",
            "marks": 1
          }
        ],
        "expectedAnswer": "DECLARE i : INTEGER\n\nFOR i <- 1 TO 20\n    IF i > 10 THEN\n        OUTPUT i\n    ENDIF\nNEXT i",
        "unlock": {
          "markScheme": "after_submit",
          "expectedAnswer": "after_submit"
        }
      }
    },
    {
      "id": "logic-practice-3",
      "type": "practice",
      "title": "Count Numbers Less Than 50",
      "task": "Write pseudocode to input 6 numbers and count how many are less than 50.",
      "difficulty": "medium",
      "expectedThinking": [
        "Multiple inputs -> loop",
        "Check each input -> IF",
        "Track result -> count variable"
      ],
      "assessment": {
        "totalMarks": 7,
        "markScheme": [
          {
            "criterion": "DECLARE variables",
            "marks": 1
          },
          {
            "criterion": "Initialize count",
            "marks": 1
          },
          {
            "criterion": "Correct loop for 6 inputs",
            "marks": 2
          },
          {
            "criterion": "Correct IF condition",
            "marks": 1
          },
          {
            "criterion": "Increment count correctly",
            "marks": 1
          },
          {
            "criterion": "OUTPUT count",
            "marks": 1
          }
        ],
        "expectedAnswer": "DECLARE num, count, i : INTEGER\n\ncount <- 0\n\nFOR i <- 1 TO 6\n    INPUT num\n\n    IF num < 50 THEN\n        count <- count + 1\n    ENDIF\nNEXT i\n\nOUTPUT count",
        "unlock": {
          "markScheme": "after_submit",
          "expectedAnswer": "after_submit"
        }
      }
    }
