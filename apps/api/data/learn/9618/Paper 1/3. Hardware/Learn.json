      "id": "memory-in-devices",
      "title": "Memory in Devices",
      "slides": [
        {
          "id": "hw-notes-2",
          "type": "concept",
          "title": "Memory in Devices",
          "duration": 12,
          "blocks": [
            {
              "type": "list",
              "items": [
                "DRAM is denser/cheaper than SRAM but needs refresh",
                "EEPROM can be electrically rewritten in-circuit",
                "EPROM requires UV erasure and usually physical removal"
              ]
            }
          ]
        },
        {
          "id": "hw-tryit-2",
          "type": "tryit",
          "title": "Try It: Memory Matching",
          "task": "Match each memory type to its best description.",
          "marks": 4,
          "responseMode": "matching",
          "responseConfig": {
            "matchingPairs": [
              {
                "id": "m1",
                "left": "DRAM",
                "options": [
                  "Needs refresh cycles",
                  "Retains data with no power",
                  "Erased by UV light"
                ],
                "answer": "Needs refresh cycles"
              },
              {
                "id": "m2",
                "left": "EEPROM",
                "options": [
                  "Electrically erased and rewritten",
                  "Write-once only",
                  "Acts as volatile cache only"
                ],
                "answer": "Electrically erased and rewritten"
              },
              {
                "id": "m3",
                "left": "EPROM",
                "options": [
                  "Erased by UV light",
                  "Always embedded in CPU cache",
                  "Only stores audio"
                ],
                "answer": "Erased by UV light"
              }
            ]
          }
        }
      ]
    },
