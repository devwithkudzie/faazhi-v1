          "responseMode": "matching",
          "responseConfig": {
            "matchingPairs": [
              {
                "id": "m1",
                "left": "Swapping processes between RAM and secondary storage",
                "options": [
                  "Memory management",
                  "File management",
                  "Translator management"
                ],
                "answer": "Memory management"
              },
              {
                "id": "m2",
                "left": "Allocating CPU time slices",
                "options": [
                  "Process management",
                  "Backup utility",
                  "Compression"
                ],
                "answer": "Process management"
              },
              {
                "id": "m3",
                "left": "Controlling read/write file permissions",
                "options": [
                  "File/security management",
                  "Assembler operation",
                  "Bus control"
                ],
                "answer": "File/security management"
              }
            ]
          }
        }
