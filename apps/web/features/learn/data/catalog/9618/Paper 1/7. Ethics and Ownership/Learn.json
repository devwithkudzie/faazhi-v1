              {
                "id": "f2",
                "label": "Software ______ determines legal use and distribution rights.",
                "answer": "licence"
              },
              {
                "id": "f3",
                "label": "Copyright law protects creators from unauthorised ______ of their work.",
                "answer": "copying"
              },
              {
                "id": "f4",
