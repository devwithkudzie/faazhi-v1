          "id": "eth-notes-1",
          "type": "concept",
          "title": "Professional Ethics",
          "duration": 12,
          "blocks": [
            {
              "type": "list",
              "items": [
                "Ethical practice protects users, colleagues and public trust",
                "Professional bodies (e.g. BCS, IEEE) provide standards and accountability",
                "Unethical behaviour can cause legal, safety and reputational harm"
              ]
            }
          ]
        },
        {
          "id": "eth-tryit-1",
          "type": "tryit",
          "title": "Try It: Ethics Statements",
          "task": "Select all statements that align with professional ethics.",
          "marks": 4,
          "responseMode": "checkbox",
          "responseConfig": {
            "allowMultiple": true,
            "checkboxOptions": [
              {
                "id": "c1",
                "label": "Report limitations or risks honestly to stakeholders.",
                "isCorrect": true
              },
              {
                "id": "c2",
                "label": "Ignore security flaws if deadlines are tight.",
                "isCorrect": false
              },
              {
                "id": "c3",
                "label": "Respect privacy and confidentiality obligations.",
                "isCorrect": true
              },
              {
                "id": "c4",
                "label": "Use unlicensed software in production if cheaper.",
                "isCorrect": false
              }
            ]
          }
        }
