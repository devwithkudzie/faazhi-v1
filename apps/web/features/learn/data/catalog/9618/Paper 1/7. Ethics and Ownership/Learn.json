    {
      "id": "licensing-and-ownership",
      "title": "Licensing and Ownership",
      "slides": [
        {
          "id": "eth-notes-2",
          "type": "concept",
          "title": "Licensing and Ownership",
          "duration": 12,
          "blocks": [
            {
              "type": "paragraph",
              "text": "You should justify license choice from business needs: rights, cost, maintenance, and distribution model."
            }
          ]
        },
        {
          "id": "eth-notes-2__slide-2",
          "type": "concept",
          "title": "Licensing and Ownership (2/2)",
          "duration": 12,
          "blocks": [
            {
              "type": "list",
              "items": [
                "Shareware allows trial/limited use",
                "Commercial licences usually involve paid use and controlled distribution",
                "Open-source licences provide source access under licence terms"
              ]
            }
          ],
          "startsBlock": false
        },
        {
          "id": "eth-tryit-2",
          "type": "tryit",
          "title": "Try It: Licence Matching",
          "task": "Match each scenario to the most suitable licence type.",
          "marks": 4,
          "responseMode": "matching",
          "responseConfig": {
            "matchingPairs": [
              {
                "id": "m1",
                "left": "Paid proprietary product with vendor updates",
                "options": [
                  "Commercial",
                  "Shareware",
                  "Public domain"
                ],
                "answer": "Commercial"
              },
              {
                "id": "m2",
                "left": "Try-before-buy distribution model",
                "options": [
                  "Shareware",
                  "Commercial",
                  "Firmware ROM"
                ],
                "answer": "Shareware"
              },
              {
                "id": "m3",
                "left": "Software where source can be modified under licence terms",
                "options": [
                  "Open source",
                  "Commercial only",
                  "Encrypted archive"
                ],
                "answer": "Open source"
              }
            ]
          }
        }
      ]
    },
    {
