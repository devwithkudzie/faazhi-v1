      "id": "von-neumann-and-registers",
      "title": "Von Neumann and Registers",
      "slides": [
        {
          "id": "pf-notes-1",
          "type": "concept",
          "title": "Von Neumann and Registers",
          "duration": 12,
          "blocks": [
            {
              "type": "list",
              "items": [
                "PC stores address of next instruction",
                "MAR stores memory address being accessed",
                "MDR stores data transferred to/from memory",
                "CIR stores current instruction"
              ]
            }
          ]
        },
        {
          "id": "pf-tryit-1",
          "type": "tryit",
          "title": "Try It: Register Roles",
          "task": "Match each register to its role.",
          "marks": 4,
          "responseMode": "matching",
          "responseConfig": {
            "matchingPairs": [
              {
                "id": "m1",
                "left": "PC",
                "options": [
                  "Current instruction",
                  "Next instruction address",
                  "Data from memory"
                ],
                "answer": "Next instruction address"
              },
              {
                "id": "m2",
                "left": "MAR",
                "options": [
                  "Memory address being accessed",
                  "ALU flags",
                  "Output value"
                ],
                "answer": "Memory address being accessed"
              },
              {
                "id": "m3",
                "left": "MDR",
                "options": [
                  "Data moving to/from memory",
                  "Program source code",
                  "Network packet"
                ],
                "answer": "Data moving to/from memory"
              }
            ]
          }
        }
      ]
    },
