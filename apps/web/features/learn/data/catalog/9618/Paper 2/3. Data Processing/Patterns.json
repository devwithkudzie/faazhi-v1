    {
      "id": "pattern-3-highest-lowest",
      "title": "Pattern 3 - Highest / Lowest",
      "slides": [
        {
          "id": "dp-pattern-3-notes",
          "type": "concept",
          "title": "Pattern 3 - Highest / Lowest",
          "duration": 12,
          "blocks": [
            {
              "type": "paragraph",
              "text": "Use this pattern when the question asks for the largest or smallest value."
            }
          ]
        },
        {
          "id": "dp-pattern-3-notes__slide-2",
          "type": "concept",
          "title": "Pattern 3 - Highest / Lowest: Code pattern",
          "duration": 12,
          "blocks": [
            {
              "type": "code",
              "language": "pseudocode",
              "text": "INPUT value\nhighest <- value\n\nFOR i <- 2 TO n\n    INPUT value\n    IF value > highest THEN\n        highest <- value\n    ENDIF\nNEXT i\n\nOUTPUT highest"
            }
          ],
          "startsBlock": false
        },
        {
          "id": "dp-pattern-3-tryit",
          "type": "tryit",
          "title": "Try It - Highest and Average",
          "task": "Paste exact question text from 9618/21/M/J/21 Q2(c). Pattern focus: input 50 unique integer values, find largest, calculate average excluding largest.",
          "marks": 6,
          "expectedAnswer": "DECLARE value, highest, total, average, i : INTEGER\n\nINPUT value\nhighest <- value\ntotal <- value\n\nFOR i <- 2 TO 50\n    INPUT value\n    total <- total + value\n\n    IF value > highest THEN\n        highest <- value\n    ENDIF\nNEXT i\n\naverage <- (total - highest) / 49\n\nOUTPUT highest\nOUTPUT average",
          "markScheme": [
            {
              "criterion": "Correct loop/input structure for 50 values",
              "marks": 1
            },
            {
              "criterion": "Correct total accumulation",
              "marks": 1
            },
            {
              "criterion": "Correct largest-value tracking",
              "marks": 2
            },
            {
              "criterion": "Correct average excluding largest",
              "marks": 1
            },
            {
              "criterion": "Outputs largest and average",
              "marks": 1
            }
          ]
        }
      ]
    },
    {
      "id": "pattern-4-2d-array-processing",
      "title": "Pattern 4 - 2D Array Processing",
      "slides": [
        {
          "id": "dp-pattern-4-notes",
          "type": "concept",
          "title": "Pattern 4 - 2D Array Processing",
          "duration": 12,
          "blocks": [
            {
              "type": "paragraph",
              "text": "Use this pattern when data is stored in rows and columns and each row/column must be processed."
            }
          ]
        },
        {
          "id": "dp-pattern-4-notes__slide-2",
          "type": "concept",
          "title": "Pattern 4 - 2D Array Processing: Code pattern",
          "duration": 12,
          "blocks": [
            {
              "type": "code",
              "language": "pseudocode",
              "text": "FOR column <- 1 TO NumberOfColumns\n    total <- 0\n    count <- 0\n\n    FOR row <- 1 TO NumberOfRows\n        IF Data[row, column] > limit THEN\n            total <- total + Data[row, column]\n            count <- count + 1\n        ENDIF\n    NEXT row\n\n    Result[column] <- total / count\nNEXT column"
            }
          ],
          "startsBlock": false
        },
