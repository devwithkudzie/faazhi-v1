    {
      "id": "pattern-1-count-with-condition",
      "title": "Pattern 1 - Count With Condition",
      "slides": [
        {
          "id": "dp-pattern-1-notes",
          "type": "concept",
          "title": "Pattern 1 - Count With Condition",
          "duration": 12,
          "blocks": [
            {
              "type": "paragraph",
              "text": "Use this pattern when the question asks how many values meet a condition."
            }
          ]
        },
        {
          "id": "dp-pattern-1-notes__slide-2",
          "type": "concept",
          "title": "Pattern 1 - Count With Condition: Code pattern",
          "duration": 12,
          "blocks": [
            {
              "type": "code",
              "language": "pseudocode",
              "text": "count <- 0\n\nFOR i <- 1 TO n\n    IF value meets condition THEN\n        count <- count + 1\n    ENDIF\nNEXT i\n\nOUTPUT count"
            }
          ],
          "startsBlock": false
        },
        {
          "id": "dp-pattern-1-tryit",
          "type": "tryit",
          "title": "Try It - Count With Condition",
          "task": "Paste exact question text from 9618/22/M/J/21 Q5(a)(i). Pattern focus: declare 1D array RNum, generate random values, count values in the inclusive range 66 to 173, output count.",
          "marks": 6,
          "expectedAnswer": "DECLARE RNum : ARRAY[1:100] OF INTEGER\nDECLARE i, count : INTEGER\n\ncount <- 0\n\nFOR i <- 1 TO 100\n    RNum[i] <- RANDOM(1, 200)\n\n    IF RNum[i] >= 66 AND RNum[i] <= 173 THEN\n        count <- count + 1\n    ENDIF\nNEXT i\n\nOUTPUT count",
          "markScheme": [
            {
              "criterion": "Correct 1D array declaration",
              "marks": 1
            },
            {
              "criterion": "Correct loop for 100 elements",
              "marks": 1
            },
            {
              "criterion": "Correct random generation in range 1 to 200",
              "marks": 1
            },
            {
              "criterion": "Correct inclusive range condition",
              "marks": 1
            },
            {
              "criterion": "Correct count increment",
              "marks": 1
            },
            {
              "criterion": "OUTPUT count",
              "marks": 1
            }
          ]
        }
      ]
    },
    {
      "id": "pattern-2-total-and-average",
      "title": "Pattern 2 - Total and Average",
      "slides": [
        {
          "id": "dp-pattern-2-notes",
          "type": "concept",
          "title": "Pattern 2 - Total and Average",
          "duration": 12,
          "blocks": [
            {
              "type": "paragraph",
              "text": "Use this pattern when the question asks for a total, an average, or both."
            }
          ]
        },
        {
          "id": "dp-pattern-2-notes__slide-2",
          "type": "concept",
          "title": "Pattern 2 - Total and Average: Code pattern",
          "duration": 12,
          "blocks": [
            {
              "type": "code",
              "language": "pseudocode",
              "text": "total <- 0\n\nFOR i <- 1 TO n\n    INPUT value\n    total <- total + value\nNEXT i\n\naverage <- total / n\nOUTPUT average"
            }
          ],
          "startsBlock": false
        },
