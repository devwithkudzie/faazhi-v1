          "blocks": [
            {
              "type": "code",
              "language": "pseudocode",
              "text": "total <- 0\ncount <- 0\n\nFOR row <- 1 TO maxRows\n    IF record is used THEN\n        count <- count + 1\n        total <- total + value\n\n        IF value meets condition THEN\n            OUTPUT key\n        ENDIF\n    ENDIF\nNEXT row\n\nOUTPUT total / count"
